@inherits LayoutComponentBase
@using Crawl.Services
@inject NavigationManager Navigation
@inject CurrentUser Current
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        @if (string.IsNullOrEmpty(Current.UserName))
        {
            <div class="top-row px-4" >
                <NavLink class="nav-link" href="register">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Register
                </NavLink>
                <NavLink class="nav-link" href="login">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Login
                </NavLink>
            </div>
        }
        else
        {
            <div class="top-row px-4" >
                <strong>@Current.UserName</strong>
                </div>
        }

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code{
    protected override void OnInitialized()
    {
        var CurrentUser = Current;
        if (CurrentUser.UserId != 0 && string.IsNullOrEmpty(CurrentUser.UserName))
        {
            Navigation.NavigateTo("/");
        }
    }

}
@page "/register"
@using Crawl.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using System.Security.Claims

@inject UserManager<AppUser> UserManager
@inject AppDbContext Db
@inject NavigationManager Nav

<h3>Register</h3>

<EditForm Model="@employee" OnValidSubmit="RegisterUser">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="mb-3">
        <label>Full Name</label>
        <InputText class="form-control" @bind-Value="employee.FullName" />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <InputText class="form-control" @bind-Value="employee.Email" />
    </div>

    <div class="mb-3">
        <label>Password</label>
        <InputText type="password" class="form-control" @bind-Value="employee.Password" />
    </div>

    <div class="mb-3">
        <label>Role</label>
        <InputSelect class="form-select" @bind-Value="employee.Role">
            <option value="Employee">Employee</option>
            <option value="Manager">Manager</option>
        </InputSelect>
    </div>

    <div class="mb-3">
        <label>Salary</label>
        <InputNumber class="form-control" @bind-Value="employee.Salary" />
    </div>

    <div class="mb-3">
        <label>Age</label>
        <InputNumber class="form-control" @bind-Value="employee.Age" />
    </div>

    <!-- COUNTRY DROPDOWN -->
    <div class="mb-3">
        <label>Country</label>
        <InputSelect class="form-select" @bind-Value="employee.CountryId">
            <option value="">Select Country</option>
            @foreach (var c in Countries)
            {
                <option value="@c.Id">@c.Name</option>
            }
        </InputSelect>
    </div>

    <!-- DEPARTMENT DROPDOWN -->
    <div class="mb-3">
        <label>Department</label>
        <InputSelect class="form-select" @bind-Value="employee.DepartmentId">
            <option value="0">Select Department</option>
            @foreach (var d in Departments)
            {
                <option value="@d.Id">@d.Name</option>
            }
        </InputSelect>
    </div>

    <button class="btn btn-primary">Register</button>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="text-danger mt-2">@error</div>
    }
</EditForm>

@code {
    private Employee employee = new();
    private List<Country> Countries = new();
    private List<Department> Departments = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        Countries = await Db.Countries.ToListAsync();
        Departments = await Db.Departments.ToListAsync();
    }

    private async Task RegisterUser()
    {
        error = null;

        if (string.IsNullOrEmpty(employee.Role))
            employee.Role = "Employee";

        var countryName = Countries
            .FirstOrDefault(c => c.Id == employee.CountryId)?.Name ?? "Unknown";

        var appUser = new AppUser
        {
            UserName = employee.Email,
            Email = employee.Email,
            Name = employee.FullName,
            Country = countryName,
            Age = employee.Age ?? 18
        };

        var result = await UserManager.CreateAsync(appUser, employee.Password);

        if (!result.Succeeded)
        {
            error = string.Join(", ", result.Errors.Select(e => e.Description));
            return;
        }
        await UserManager.AddClaimAsync(appUser,
    new Claim("FullName", appUser.Name));

        await UserManager.AddToRoleAsync(appUser, employee.Role);

        // Link employee to identity
        employee.UserId = appUser.Id;
        employee.IsFirstLogin = true;

        Db.Employees.Add(employee);
        await Db.SaveChangesAsync();

        Nav.NavigateTo("/login", true);
    }
}
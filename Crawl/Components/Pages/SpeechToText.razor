@page "/getcontent"
@using Crawl.IServices
@inject ISpeechToTextService SpeechService

<h3>Speech To Text (Arabic + English)</h3>

<InputFile OnChange="OnFileSelected" accept=".mp3,.wav,.mp4,.avi,.mkv" />

@if (isProcessing)
{
    <p>⏳ Processing...</p>
}

@if (!string.IsNullOrEmpty(resultPath))
{
    <p>✅ Done!</p>
    <a href="@resultPath" download>Download Transcription</a>
}

@code {
    private bool isProcessing;
    private string? resultPath;

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        resultPath = null;

        var file = e.File;
        await using var stream = file.OpenReadStream(maxAllowedSize: 500_000_000);

        resultPath = await SpeechService.TranscribeAsync(stream, file.Name);

        isProcessing = false;
    }
}

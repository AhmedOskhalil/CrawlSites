@code {
    private int currentCount = 0;
    [Parameter]
    public List<Models.Partition> Partitiones { get; set; } = new List<Models.Partition>();
    public List<Models.Partition> YPartitiones { get; set; } = new List<Models.Partition>();
    public List<Models.Partition> TPartitiones { get; set; } = new List<Models.Partition>();
    public List<Models.Partition> PPartitiones { get; set; } = new List<Models.Partition>();
    public bool Today;
    public bool YesterDay;
    public bool Tommorrow;
    public bool Pday;
    private DateTime SelectedDate = DateTime.Now;

    private string FormattedDate =>
        SelectedDate.ToString("yyyy-MM-dd");
    protected override async Task OnInitializedAsync()
    {
        string todaydate = DateTime.Now.ToString("yyyy-MM-dd");
        string tommorrowdate = DateTime.Now.ToString("yyyy-MM-dd");
        string yesterdaydate = DateTime.Now.ToString("yyyy-MM-dd");
        Partitiones = await CrawlService.RunSearchDayAsync(todaydate);
        TPartitiones = await CrawlService.RunSearchDayAsync(tommorrowdate);
        YPartitiones = await CrawlService.RunSearchDayAsync(yesterdaydate);
        Today = true;
        YesterDay = false;
        Tommorrow = false;
        Pday = false;


    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return base.OnAfterRenderAsync(firstRender);
    }

    private void IncrementCount()
    {
        currentCount++;
    }
    public DateTime ToDateTime(string dotNetDate)
    {
        if (string.IsNullOrEmpty(dotNetDate))
            return DateTime.MinValue;

        var match = Regex.Match(dotNetDate, @"\d+");
        if (!match.Success)
            return DateTime.MinValue;

        long ms = long.Parse(match.Value);
        return DateTimeOffset
            .FromUnixTimeMilliseconds(ms)
            .LocalDateTime;
    }
    public async Task tommorrow()
    {
        Tommorrow = true;
        YesterDay = false;
        Pday = false; ;
        Today = false;
    }
    public async Task yesterday()
    {
        Tommorrow = false;
        YesterDay = true;
        Pday = false;
        Today = false;

    }
    public async Task today()
    {
        Tommorrow = false;
        YesterDay = false;
        Pday = true;
        Today = true;

    }
    public async Task searchforday()
    {
        PPartitiones = await CrawlService.RunSearchDayAsync(FormattedDate);
        Tommorrow = false;
        YesterDay = false;
        Today = false;
        Pday = true;
    }


}

@page "/counter"
@using System.Text.RegularExpressions;
@using System.Text.Json;
@using System.Threading.Tasks
@rendermode InteractiveServer
@inject Services.CrawlService CrawlService
@inject IJSRuntime JS
<PageTitle>Matches</PageTitle>

<div class="container py-4">

    <h1 class="text-center fw-bold mb-4">⚽ All Matches</h1>

    <!-- Top Controls -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap gap-2 justify-content-center">

            <button class="btn btn-outline-primary px-4" @onclick="today">Today</button>
            <button class="btn btn-outline-secondary px-4" @onclick="yesterday">Yesterday</button>
            <button class="btn btn-outline-info px-4" @onclick="tommorrow">Tomorrow</button>

            <button class="btn btn-success px-4 ms-2" @onclick="today">
                🔄 Refresh
            </button>

            <input type="date"
                   class="form-control w-auto ms-3"
                   style="min-width:180px"
                   @bind="SelectedDate"
                   @bind:format="yyyy-MM-dd" />

            <button class="btn btn-dark px-4" @onclick="searchforday">
                Search
            </button>

        </div>
    </div>


    @* TODAY *@
    @if (Today)
    {
        <h3 class="mb-3 text-primary fw-bold">Today</h3>

        <!-- Partition Select -->
        <select class="form-select mb-3 w-50 shadow-sm"
                @bind="SelectedTodayPartition">
            <option value="">All Leagues</option>
            @foreach (var p in Partitiones)
            {
                <option value="@p.PartitionName">@p.PartitionName</option>
            }
        </select>

        @foreach (var partition in Partitiones
            .Where(p => string.IsNullOrEmpty(SelectedTodayPartition)
            || p.PartitionName == SelectedTodayPartition))
        {
            <div class="card shadow-sm mb-4 border-0">

                <div class="card-header bg-primary text-white fw-bold">
                    🏆 @partition.PartitionName
                </div>

                <div class="table-responsive shadow">
                    <table class="table table-hover align-middle mb-0 shadow">
                        <thead class="table-light">
                            <tr>
                                <th>Home</th>
                                <th class="text-center">Score</th>
                                <th class="text-end">Away</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var match in partition.Matchs)
                            {
                                <tr>
                                    <td>
                                        <img src="@match.HomeLogo" width="32"
                                             class="me-2 rounded-circle" />
                                        <strong>@match.HomeTeamName</strong>
                                    </td>

                                    <td class="text-center fw-bold fs-5">
                                        @match.HomeScore : @match.AwayScore
                                    </td>

                                    <td class="text-end">
                                        <strong>@match.AwayTeamName</strong>
                                        <img  src="@match.AwayLogo" width="32"
                                             class="ms-2 rounded-circle" />
                                             <button class="btn btn-sm btn-outline-secondary ms-3"
                                                     @onclick="() => GetCurrentTeamInformation(match.AwayLogo)"></button>
                                            ℹ️
                                    </td>

                                    <td class="text-muted small">
                                        @match.Date
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

            </div>
        }
    }


    @if (Tommorrow)
    {
        <h3 class="mb-3 text-info fw-bold">Tomorrow</h3>

        <select class="form-select mb-3 w-50 shadow-sm"
                @bind="SelectedTomorrowPartition">
            <option value="">All Leagues</option>
            @foreach (var p in TPartitiones)
            {
                <option value="@p.PartitionName">@p.PartitionName</option>
            }
        </select>

        @foreach (var partition in TPartitiones
            .Where(p => string.IsNullOrEmpty(SelectedTomorrowPartition)
            || p.PartitionName == SelectedTomorrowPartition))
        {
            <div class="card shadow-sm mb-4 border-0">

                <div class="card-header bg-info text-white fw-bold">
                    🏆 @partition.PartitionName
                </div>
                <div class="table-responsive shadow">
                    <table class="table table-hover align-middle mb-0 shadow">

                        <thead class="table-light">
                            <tr>
                                <th>Home</th>
                                <th class="text-center">Score</th>
                                <th class="text-end">Away</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var match in partition.Matchs)
                            {
                                <tr>
                                    <td>
                                        <img src="@match.HomeLogo" width="32" class="me-2 rounded-circle" />
                                        <strong>@match.HomeTeamName</strong>
                                    </td>

                                    <td class="text-center fw-bold fs-5">
                                        @match.HomeScore : @match.AwayScore
                                    </td>

                                    <td class="text-end">
                                        <strong>@match.AwayTeamName</strong>
                                        <img src="@match.AwayLogo" width="32" class="ms-2 rounded-circle" />
                                    </td>

                                    <td class="text-muted small">
                                        @match.Date
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }
    }


    @* YESTERDAY *@
 
    @if (YesterDay)
    {
        <h3 class="mb-3 text-secondary fw-bold">Yesterday</h3>

        <select class="form-select mb-3 w-50 shadow-sm"
                @bind="SelectedYesterdayPartition">
            <option value="">All Leagues</option>
            @foreach (var p in YPartitiones)
            {
                <option value="@p.PartitionName">@p.PartitionName</option>
            }
        </select>

        @foreach (var partition in YPartitiones
            .Where(p => string.IsNullOrEmpty(SelectedYesterdayPartition)
            || p.PartitionName == SelectedYesterdayPartition))
        {
            <div class="card shadow-sm mb-4 border-0">

                <div class="card-header bg-secondary text-white fw-bold">
                    🏆 @partition.PartitionName
                </div>
                <div class="table-responsive shadow">
                    <table class="table table-hover align-middle mb-0 shadow">

                        <thead class="table-light">
                            <tr>
                                <th>Home</th>
                                <th class="text-center">Score</th>
                                <th class="text-end">Away</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var match in partition.Matchs)
                            {
                                <tr>
                                    <td>
                                        <img src="@match.HomeLogo" width="32" class="me-2 rounded-circle" />
                                        <strong>@match.HomeTeamName</strong>
                                    </td>

                                    <td class="text-center fw-bold fs-5">
                                        @match.HomeScore : @match.AwayScore
                                    </td>

                                    <td class="text-end">
                                        <strong>@match.AwayTeamName</strong>
                                        <img src="@match.AwayLogo" width="32" class="ms-2 rounded-circle" />
                                    </td>

                                    <td class="text-muted small">
                                        @match.Date
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }
    }


    @* PARTICULAR DAY *@

    @if (Pday)
    {
        <h3 class="mb-3 text-dark fw-bold">Selected Day</h3>

        <select class="form-select mb-3 w-50 shadow-sm"
                @bind="SelectedParticularPartition">
            <option value="">All Leagues</option>
            @foreach (var p in PPartitiones)
            {
                <option value="@p.PartitionName">@p.PartitionName</option>
            }
        </select>

        @foreach (var partition in PPartitiones
            .Where(p => string.IsNullOrEmpty(SelectedParticularPartition)
            || p.PartitionName == SelectedParticularPartition))
        {
            <div class="card shadow-sm mb-4 border-0">

                <div class="card-header bg-dark text-white fw-bold">
                    🏆 @partition.PartitionName
                </div>

                <div class="table-responsive shadow">
                    <table class="table table-hover align-middle mb-0 shadow">

                        <thead class="table-light">
                            <tr>
                                <th>Home</th>
                                <th class="text-center">Score</th>
                                <th class="text-end">Away</th>
                                <th>Date</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var match in partition.Matchs)
                            {
                                <tr>
                                    <td>
                                        <img src="@match.HomeLogo" width="32" class="me-2 rounded-circle" />
                                        <strong>@match.HomeTeamName</strong>
                                    </td>

                                    <td class="text-center fw-bold fs-5">
                                        @match.HomeScore : @match.AwayScore
                                    </td>

                                    <td class="text-end">
                                        <strong>@match.AwayTeamName</strong>
                                        <img src="@match.AwayLogo" width="32" class="ms-2 rounded-circle" />
                                    </td>

                                    <td class="text-muted small">
                                        @match.Date
                                    </td>
                                </tr>
                            }
                        </tbody>

                    </table>
                </div>
            </div>
        }
    }

</div>



@code {
    private int currentCount = 0;
    [Parameter]
    public List<Models.Partition> Partitiones { get; set; } = new List<Models.Partition>();
    public List<Models.Partition> YPartitiones { get; set; } = new List<Models.Partition>();
    public List<Models.Partition> TPartitiones { get; set; } = new List<Models.Partition>();
    public List<Models.Partition> PPartitiones { get; set; } = new List<Models.Partition>();
    private string? SelectedTodayPartition;
    private string? SelectedYesterdayPartition;
    private string? SelectedTomorrowPartition;
    private string? SelectedParticularPartition;
    public bool Today;
    public bool YesterDay;
    public bool Tommorrow;
    public bool Pday;
    private DateTime SelectedDate = DateTime.Now;

    private string FormattedDate =>
        SelectedDate.ToString("yyyy-MM-dd");
    protected override async Task OnInitializedAsync()
    {
        string todaydate = DateTime.Now.ToString("yyyy-MM-dd");
        string tommorrowdate = DateTime.Now.AddDays(1).ToString("yyyy-MM-dd");
        string yesterdaydate = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd");
        Partitiones = await CrawlService.RunSearchDayAsync(todaydate);
        TPartitiones = await CrawlService.RunSearchDayAsync(tommorrowdate);
        YPartitiones = await CrawlService.RunSearchDayAsync(yesterdaydate);
        Today = true;
        YesterDay = false;
        Tommorrow = false;
        Pday = false;


    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return base.OnAfterRenderAsync(firstRender);
    }

    private void IncrementCount()
    {
        currentCount++;
    }
    public DateTime ToDateTime(string dotNetDate)
    {
        if (string.IsNullOrEmpty(dotNetDate))
            return DateTime.MinValue;

        var match = Regex.Match(dotNetDate, @"\d+");
        if (!match.Success)
            return DateTime.MinValue;

        long ms = long.Parse(match.Value);
        return DateTimeOffset
            .FromUnixTimeMilliseconds(ms)
            .LocalDateTime;
    }
    public async Task tommorrow()
    {
        Tommorrow = true;
        YesterDay = false;
        Pday = false; ;
        Today = false;
    }
    public async Task yesterday()
    {
        Tommorrow = false;
        YesterDay = true;
        Pday = false;
        Today = false;

    }
    public async Task today()
    {
        Tommorrow = false;
        YesterDay = false;
        Pday = false;
        Today = true;

    }
    public async Task searchforday()
    {
        PPartitiones = await CrawlService.RunSearchDayAsync(FormattedDate);
        Tommorrow = false;
        YesterDay = false;
        Today = false;
        Pday = true;
    }
    public async Task  GetCurrentTeamInformation(string logo)
    {
        int Url = int.Parse(logo.Split('/').LastOrDefault()?.Replace(".png", "") ?? "");
        var matchInformation = await CrawlService.GetTeamInformationAsync(Url);
        Console.WriteLine($"Team Information: {matchInformation}");
    }


}

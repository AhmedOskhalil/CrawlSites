@page "/counter"
@using System.Text.RegularExpressions;
@using System.Text.Json;
@using System.Threading.Tasks
@rendermode InteractiveServer
@inject Services.CrawlService CrawlService
@inject IJSRuntime JS
<PageTitle>Matches</PageTitle>

<h1>All Matches</h1>

<button class="btn btn-primary" @onclick="today">Today</button>
<button class="btn btn-primary" @onclick="yesterday">YesterDay</button>
<button class="btn btn-primary" @onclick="tommorrow">Tommorow</button>
<button class="btn btn-success" @onclick="today">Refresh</button>

<input type="date"
       style="padding:10px 12px;border-radius:8px;border:1px solid #d0d5dd;font-size:14px;width:260px"
       @bind="SelectedDate"
       @bind:format="yyyy-MM-dd" />
<button class="btn btn-success" @onclick="searchforday">
    Search With Particular Date
</button>


@* TODAY *@
@if (Today)
{
    <h1>Today</h1>
    @foreach (var partition in Partitiones)
    {
        <div class="card-body">
            <h2>@partition.PartitionName</h2>
            <table class="table table-sm table-striped mb-0">
                <thead>
                    <tr>
                        <th>Home</th>
                        <th>Score</th>
                        <th>Away</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    
                    @foreach (var match in @partition.Matchs)
                    {
                        <tr>
                            <td><img src="@match.HomeLogo" width="50" height="50" /><strong>@match.HomeTeamName</strong>  </td>
                            <td><strong>@match.HomeScore : @match.AwayScore</strong> </td>
                            <td><img src="@match.AwayLogo" width="50" height="50" /><strong>@match.AwayTeamName</strong></td>
                            <td class="text-muted small">@match.Date</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }


}


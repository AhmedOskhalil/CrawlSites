@page "/counter"

@using System.Text.RegularExpressions;
@using System.Text.Json;
@using System.Threading.Tasks
@using Services
@using Crawl.Components.Pages
@rendermode InteractiveServer
@inject Services.CrawlService CrawlService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TeamInformationGlobal TeamInfo
<PageTitle>Matches</PageTitle>

<div class="container py-4">

    <h1 class="text-center fw-bold mb-4">⚽ جميع المباريات
        <button class="btn btn-outline-dark px-4" @onclick="GoToArticles">الأخبار 📰 </button>

    </h1>
    
    <!-- Top Controls -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex flex-wrap gap-2 justify-content-center">
            <button class="btn btn-outline-primary px-4" @onclick="today">Today</button>
            <button class="btn btn-outline-secondary px-4" @onclick="yesterday">Yesterday</button>
            <button class="btn btn-outline-info px-4" @onclick="tommorrow">Tomorrow</button>

            <button class="btn btn-success px-4 ms-2" @onclick="today">
                🔄 Refresh
            </button>

            <input type="date"
                   class="form-control w-auto ms-3"
                   style="min-width:180px"
                   @bind="SelectedDate"
                   @bind:format="yyyy-MM-dd" />

            <button class="btn btn-dark px-4" @onclick="searchforday">
                Search
            </button>

        </div>
    </div>
    
    <Matches Partitiones="@Partitiones" />
</div>



@code {
    private int currentCount = 0;
    [Parameter]
    public List<Models.Partition> Partitiones { get; set; } = new List<Models.Partition>();

    string todaydate = DateTime.Now.ToString("yyyy-MM-dd");
    string tommorrowdate = DateTime.Now.AddDays(1).ToString("yyyy-MM-dd");
    string yesterdaydate = DateTime.Now.AddDays(-1).ToString("yyyy-MM-dd");

    private DateTime SelectedDate = DateTime.Now;


    private string FormattedDate =>
        SelectedDate.ToString("yyyy-MM-dd");
    protected override async Task OnInitializedAsync()
    {
        Partitiones = await CrawlService.RunSearchDayAsync(todaydate);
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        return base.OnAfterRenderAsync(firstRender);
    }

    private void IncrementCount()
    {
        currentCount++;
    }
    public DateTime ToDateTime(string dotNetDate)
    {
        if (string.IsNullOrEmpty(dotNetDate))
            return DateTime.MinValue;

        var match = Regex.Match(dotNetDate, @"\d+");
        if (!match.Success)
            return DateTime.MinValue;

        long ms = long.Parse(match.Value);
        return DateTimeOffset
            .FromUnixTimeMilliseconds(ms)
            .LocalDateTime;
    }
    public async Task tommorrow()
    {
        Partitiones = await CrawlService.RunSearchDayAsync(tommorrowdate);

    }
    public async Task yesterday()
    {
        Partitiones = await CrawlService.RunSearchDayAsync(yesterdaydate);

    }
    public async Task today()
    {
        Partitiones = await CrawlService.RunSearchDayAsync(todaydate);
    }
    public async Task searchforday()
    {
        Partitiones = await CrawlService.RunSearchDayAsync(FormattedDate);
    }
    public async Task GoToArticles()
    {
        Navigation.NavigateTo("/articles");
    }


}

@page "/video-player/"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@implements IDisposable
@inject Services.Crawl.Video.VideoPlayerService VideoPlayerService

    <div class="video-page">

        <button class="back-button" @onclick="GoBack">
            ← Back
        </button>
    @if (string.IsNullOrEmpty(VideoPlayerService.VideoUrl))
        {
            <div>
                <h1>Not Found  ... </h1>
                <p>Video URL is not available. Please go back and select a video.</p>
            </div>
        }
        else
        {
            <div class="video-container">
                <iframe src="@VideoPlayerService.VideoUrl"
                        width="560"
                        height="315"
                        style="border:none;overflow:hidden"
                        scrolling="no"
                        frameborder="0"
                        allow="autoplay; clipboard-write; encrypted-media; picture-in-picture; web-share"
                        allowfullscreen>
                </iframe>
            </div>
        }
       

    </div>

    <style>
            .video-page {
                padding: 20px;
            }

            .back-button {
                margin-bottom: 15px;
                padding: 8px 16px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
            }

            .video-container {
                width: 560px;
                max-width: 100%;
                aspect-ratio: 560 / 315;
                background: #000;
                overflow: hidden;
                border-radius: 8px;
            }

                .video-container iframe {
                    width: 100%;
                    height: 100%;
                    display: block;
                    border: 0;
                }
    </style>


@code {
    protected override void OnInitialized()
    {
        VideoPlayerService.VideoChanged += OnVideoChanged;
    }

    private void OnVideoChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        VideoPlayerService.VideoChanged -= OnVideoChanged;
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/videos");
    }
}
@page "/article-content/{*ArticleUrl}"

@using Crawl.Models
@using Crawl.Services
@using Crawl.Services.Crawl

@inject CrawlService CrawlService
@inject NavigationManager NavigationContext

<div style="
min-height:100vh;
background:#0f172a;
padding:40px 25px;">

    @if (articleContent != null && !string.IsNullOrEmpty(articleContent.Title))
    {
        <div style="
            max-width:1500px;
            margin:auto;">

            <!-- ARTICLE CONTAINER -->
            <div style="
                background:#111827;
                border-radius:32px;
                overflow:hidden;
                border:1px solid rgba(255,255,255,.05);
                box-shadow:0 25px 60px rgba(0,0,0,.35);">

                <!-- HERO -->
                <div style="
                    background:linear-gradient(135deg,#2563eb,#7c3aed);
                    padding:50px 60px;
                    position:relative;">

                    <div style="
                        position:absolute;
                        top:-60px;
                        right:-60px;
                        width:220px;
                        height:220px;
                        background:rgba(255,255,255,.08);
                        border-radius:50%;"></div>

                    <div style="
                        position:absolute;
                        bottom:-80px;
                        left:-80px;
                        width:260px;
                        height:260px;
                        background:rgba(255,255,255,.05);
                        border-radius:50%;"></div>

                    <div style="
                        position:relative;
                        z-index:2;">

                        <div style="
                            display:flex;
                            align-items:center;
                            gap:12px;
                            margin-bottom:20px;">

                            <div style="
                                background:rgba(255,255,255,.15);
                                color:white;
                                padding:10px 18px;
                                border-radius:14px;
                                font-weight:700;
                                font-size:14px;">

                                📰 مقال رياضي

                            </div>

                            <div style="
                                background:rgba(255,255,255,.15);
                                color:white;
                                padding:10px 18px;
                                border-radius:14px;
                                font-weight:700;
                                font-size:14px;">

                                ⚽ كرة القدم

                            </div>

                        </div>

                        <h1 style="
                            color:white;
                            font-size:52px;
                            line-height:1.3;
                            font-weight:900;
                            margin-bottom:24px;
                            max-width:1100px;">

                            @articleContent.Title

                        </h1>

                        <div style="
                            display:flex;
                            align-items:center;
                            gap:18px;
                            flex-wrap:wrap;
                            color:rgba(255,255,255,.9);
                            font-size:16px;">

                            <div style="
                                display:flex;
                                align-items:center;
                                gap:8px;">

                                👤
                                <span>@articleContent.Author</span>

                            </div>

                            <div style="
                                width:6px;
                                height:6px;
                                border-radius:50%;
                                background:white;
                                opacity:.6;"></div>

                            <div style="
                                display:flex;
                                align-items:center;
                                gap:8px;">

                                📅
                                <span>@articleContent.PublishedDate</span>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- IMAGE -->
                @if (articleContent.Images?.Length > 0)
                {
                    <div style="
                            padding:35px 35px 0 35px;">

                        <img src="@articleContent.Images[0]"
                             style="
                                     width:100%;
                                     max-height:650px;
                                     object-fit:cover;
                                     border-radius:26px;
                                     box-shadow:0 20px 40px rgba(0,0,0,.3);" />

                    </div>
                }

                <!-- CONTENT -->
                <div style="
                    padding:50px 60px;">

                    <div style="
                        color:#e2e8f0;
                        font-size:22px;
                        line-height:2.1;
                        font-weight:400;">

                        @((MarkupString)articleContent.Text)

                    </div>

                </div>

            </div>

            <!-- RELATED ARTICLES -->
            @if (articleContent.RelatedArticles?.Count > 0)
            {
                <div style="margin-top:50px;">

                    <!-- SECTION TITLE -->
                    <div style="
                            display:flex;
                            align-items:center;
                            gap:16px;
                            margin-bottom:30px;">

                        <div style="
                                width:58px;
                                height:58px;
                                border-radius:18px;
                                background:linear-gradient(135deg,#7c3aed,#6d28d9);
                                display:flex;
                                align-items:center;
                                justify-content:center;
                                color:white;
                                font-size:26px;
                                box-shadow:0 10px 30px rgba(124,58,237,.35);">

                            📰

                        </div>

                        <div>

                            <h2 style="
                                    color:white;
                                    margin:0;
                                    font-size:40px;
                                    font-weight:900;">

                                مقالات ذات صلة

                            </h2>

                            <div style="
                                    color:#94a3b8;
                                    margin-top:6px;
                                    font-size:16px;">

                                أخبار وتحليلات مشابهة

                            </div>

                        </div>

                    </div>

                    <!-- RELATED GRID -->
                    <div style="
                            display:grid;
                            grid-template-columns:repeat(auto-fill,minmax(320px,1fr));
                            gap:26px;">

                        @foreach (var related in articleContent.RelatedArticles)
                        {
                            <div @onclick="() => GoToContent(related.Url)"
                                 style="
                                             background:#111827;
                                             border-radius:28px;
                                             overflow:hidden;
                                             cursor:pointer;
                                             border:1px solid rgba(255,255,255,.05);
                                             box-shadow:0 15px 35px rgba(0,0,0,.25);
                                             transition:.25s;">

                                <img src="@related.ImageUrl"
                                     style="
                                                 width:100%;
                                                 height:230px;
                                                 object-fit:cover;" />

                                <div style="padding:24px;">

                                    <h3 style="
                                                color:white;
                                                font-size:22px;
                                                line-height:1.7;
                                                font-weight:800;
                                                margin-bottom:20px;">

                                        @related.Title

                                    </h3>

                                    <button style="
                                                border:none;
                                                background:linear-gradient(135deg,#2563eb,#1d4ed8);
                                                color:white;
                                                padding:12px 20px;
                                                border-radius:14px;
                                                font-weight:800;">

                                        إقرأ المزيد

                                    </button>

                                </div>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div style="
            min-height:80vh;
            display:flex;
            align-items:center;
            justify-content:center;">

            <Crawl.Components.Pages.Partials.Loading Text="جاري تحميل المقالة"
                                                     Visible="true" />

        </div>
    }

</div>

@code {

    [Parameter]
    public string ArticleUrl { get; set; } = "";

    public Models.Articles.ArticleContent articleContent { get; set; } = new();

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ArticleUrl))
        {
            var decodedUrl = Uri.UnescapeDataString(ArticleUrl);

            articleContent = await CrawlService.GetArticleContentAsync(decodedUrl);
        }
    }

    private void GoToContent(string url)
    {
        if (string.IsNullOrEmpty(url)) return;

        var encodedUrl = Uri.EscapeDataString(url);

        NavigationContext.NavigateTo($"/article-content/{encodedUrl}");
    }

}
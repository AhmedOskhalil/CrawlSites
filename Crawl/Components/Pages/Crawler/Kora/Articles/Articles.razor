@page "/articles"
@using Crawl.Models.Articles
@using Crawl.Services.Crawl.Articles
@inject ArticlesCrawlService ArticleService
@inject NavigationManager NavigationContext

<div style="
min-height:100vh;
background:#0f172a;
padding:40px 30px;">

    <div style="
    max-width:1500px;
    margin:auto;">

        <!-- HEADER -->
        <div style="
        display:flex;
        justify-content:space-between;
        align-items:center;
        margin-bottom:35px;
        flex-wrap:wrap;
        gap:20px;">

            <div>

                <h1 style="
                color:white;
                font-size:52px;
                font-weight:900;
                margin-bottom:10px;">

                    📰 آخر الأخبار

                </h1>

                <div style="
                color:#94a3b8;
                font-size:18px;">

                    أحدث أخبار وتحليلات كرة القدم

                </div>

            </div>

        </div>

        <!-- SEARCH -->
        <div style="
        display:flex;
        gap:14px;
        margin-bottom:40px;
        flex-wrap:wrap;">

            <input type="text"
                   placeholder="ابحث عن الأخبار......"
                   @bind="Keyword"
                   style="
                   flex:1;
                   min-width:280px;
                   background:#111827;
                   border:1px solid #1e293b;
                   color:white;
                   padding:18px 20px;
                   border-radius:18px;
                   font-size:16px;" />

            <button @onclick="Search"
                    style="
                    border:none;
                    background:linear-gradient(135deg,#2563eb,#1d4ed8);
                    color:white;
                    padding:18px 28px;
                    border-radius:18px;
                    font-weight:800;">

                🔍 بحث

            </button>

        </div>

        <!-- ARTICLES -->
        @if (articles.Count > 0)
        {
            <div style="
                display:grid;
                grid-template-columns:repeat(auto-fill,minmax(340px,1fr));
                gap:26px;">

                @foreach (var article in articles)
                {
                    <div @onclick="() => GoToContent(article.Url)"
                         style="
                                 background:#111827;
                                 border-radius:26px;
                                 overflow:hidden;
                                 cursor:pointer;
                                 border:1px solid rgba(255,255,255,.05);
                                 box-shadow:0 15px 35px rgba(0,0,0,.25);">

                        <img src="@article.imageUrl"
                             style="
                                     width:100%;
                                     height:240px;
                                     object-fit:cover;" />

                        <div style="padding:24px;">

                            <h3 style="
                                    color:white;
                                    font-size:22px;
                                    line-height:1.5;
                                    font-weight:800;
                                    margin-bottom:20px;">

                                @article.Title

                            </h3>

                            <button style="
                                    border:none;
                                    background:linear-gradient(135deg,#7c3aed,#6d28d9);
                                    color:white;
                                    padding:12px 18px;
                                    border-radius:14px;
                                    font-weight:700;">

                                المزيد...

                            </button>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <Crawl.Components.Pages.Partials.Loading Text="Loading Reports"
                                                     Visible="true" />
        }

    </div>

</div>

@code {

    public List<Article> articles { get; set; } = new();

    public string Keyword { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        articles = await ArticleService.GetArticlesAsync();
    }

    private async Task GoToContent(string url)
    {
        if (string.IsNullOrEmpty(url)) return;

        var encodedUrl = Uri.EscapeDataString(url);

        NavigationContext.NavigateTo($"/article-content/{encodedUrl}");
    }

    private async Task Search()
    {
        articles = string.IsNullOrWhiteSpace(Keyword)
            ? await ArticleService.GetArticlesAsync()
            : await ArticleService.GetTeamArticles(Keyword);

        StateHasChanged();
    }

}
@using Crawl.Models
@using Crawl.Services
@using Crawl.Services.Crawl

@inject CrawlService CrawlService
@inject TeamInformationGlobal TeamInfo
@inject NavigationManager Navigation

@if (teamMatches == null || teamMatches.Matches == null)
{
    <div style="
        background:#111827;
        border-radius:28px;
        padding:40px;
        min-height:300px;
        display:flex;
        align-items:center;
        justify-content:center;">

        <Crawl.Components.Pages.Partials.Loading Visible="true" />

    </div>
}
else
{
    <div style="
        background:#111827;
        border-radius:32px;
        overflow:hidden;
        border:1px solid rgba(255,255,255,.05);
        box-shadow:0 20px 40px rgba(0,0,0,.35);">

        <!-- HEADER -->
        <div style="
            padding:30px;
            background:linear-gradient(135deg,#1e293b,#0f172a);
            border-bottom:1px solid rgba(255,255,255,.05);">

            <div style="
                display:flex;
                justify-content:space-between;
                align-items:center;
                flex-wrap:wrap;
                gap:20px;">

                <div style="
                    display:flex;
                    align-items:center;
                    gap:18px;">

                    <img src="@teamMatches.TeamLogo"
                         style="
                             width:90px;
                             height:90px;
                             object-fit:contain;
                             background:white;
                             border-radius:22px;
                             padding:12px;" />

                    <div>

                        <h2 style="
                            color:white;
                            font-size:38px;
                            font-weight:900;
                            margin-bottom:8px;">

                            @teamMatches.TeamName

                        </h2>

                        <div style="
                            color:#94a3b8;
                            font-size:16px;">

                            مباريات الفريق ونتائجه

                        </div>

                    </div>

                </div>

                <!-- FILTERS -->
                <div style="
                    display:flex;
                    gap:12px;
                    flex-wrap:wrap;">

                    <button @onclick="Recent"
                            style="
                                border:none;
                                background:@(!showRecent ? "linear-gradient(135deg,#2563eb,#1d4ed8)" : "#1e293b");
                                color:white;
                                padding:14px 22px;
                                border-radius:16px;
                                font-weight:800;
                                min-width:170px;">

                        ⚽ المباريات السابقة

                    </button>

                    <button @onclick="Upcoming"
                            style="
                                border:none;
                                background:@(showRecent ? "linear-gradient(135deg,#10b981,#059669)" : "#1e293b");
                                color:white;
                                padding:14px 22px;
                                border-radius:16px;
                                font-weight:800;
                                min-width:170px;">

                        🚀 المباريات القادمة
                    </button>

                </div>

            </div>

        </div>

        <!-- MATCHES -->
        <div style="
            padding:24px;
            background:#0f172a;">

            <div style="
                display:flex;
                flex-direction:column;
                gap:18px;">

                @foreach (var match in teamMatches.Matches.Where(x => x.IsFeatureMatch == showRecent))
                {
                    <div style="
                            background:#111827;
                            border-radius:24px;
                            padding:22px;
                            border:1px solid rgba(255,255,255,.04);
                            box-shadow:0 10px 30px rgba(0,0,0,.25);">

                        <div style="
                                display:flex;
                                justify-content:space-between;
                                align-items:center;
                                flex-wrap:wrap;
                                gap:20px;">

                            <!-- HOME -->
                            <div style="
                                    display:flex;
                                    align-items:center;
                                    gap:14px;
                                    flex:1;">

                                <button @onclick="() => GetCurrentTeamInformation(match.HomeLogo)"
                                        style="
                                                border:none;
                                                width:42px;
                                                height:42px;
                                                border-radius:12px;
                                                background:#1e293b;
                                                color:white;
                                                font-size:16px;">

                                    ℹ️

                                </button>

                                <img src="@match.HomeLogo"
                                     style="
                                             width:52px;
                                             height:52px;
                                             border-radius:50%;
                                             background:white;
                                             padding:4px;" />

                                <div style="
                                        color:white;
                                        font-size:18px;
                                        font-weight:800;">

                                    @match.HomeTeamName

                                </div>

                            </div>

                            <!-- SCORE -->
                            <div style="
                                    display:flex;
                                    flex-direction:column;
                                    align-items:center;
                                    justify-content:center;
                                    min-width:160px;">

                                <div style="
                                        color:#60a5fa;
                                        font-size:34px;
                                        font-weight:900;
                                        margin-bottom:8px;">

                                    @match.HomeScore
                                    :
                                    @match.AwayScore

                                </div>

                                <div style="
                                        color:#94a3b8;
                                        font-size:14px;">

                                    @match.Date

                                </div>

                            </div>

                            <!-- AWAY -->
                            <div style="
                                    display:flex;
                                    align-items:center;
                                    justify-content:flex-end;
                                    gap:14px;
                                    flex:1;">

                                <div style="
                                        color:white;
                                        font-size:18px;
                                        font-weight:800;">

                                    @match.AwayTeamName

                                </div>

                                <img src="@match.AwayLogo"
                                     style="
                                             width:52px;
                                             height:52px;
                                             border-radius:50%;
                                             background:white;
                                             padding:4px;" />

                                <button @onclick="() => GetCurrentTeamInformation(match.AwayLogo)"
                                        style="
                                                border:none;
                                                width:42px;
                                                height:42px;
                                                border-radius:12px;
                                                background:#1e293b;
                                                color:white;
                                                font-size:16px;">

                                    ℹ️

                                </button>

                            </div>

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>
}

@code {

    public Models.TeamMatches teamMatches = new();

    public bool showRecent = false;

    [Parameter]
    public int teamId { get; set; }

    protected override async Task OnInitializedAsync()
    {
        teamId = teamId > 0
            ? teamId
            : TeamInfo.TeamInformation.teamId;

        teamMatches.Matches = new List<Models.Match>();

        await LoadMatches();
    }

    public async Task LoadMatches()
    {
        await Task.Delay(500);

        teamMatches = await CrawlService.GetTeamMatchesAsync(teamId);

        await Task.Delay(500);
    }

    public async Task GetCurrentTeamInformation(string logo)
    {
        int Url = int.Parse(
            logo.Split('/').LastOrDefault()?.Replace(".png", "") ?? "0"
        );

        var info = await CrawlService.GetTeamInformationAsync(Url);

        TeamInfo.TeamInformation = info;

        Navigation.NavigateTo($"/team-information/{Url}");
    }

    public void Recent()
    {
        showRecent = false;
    }

    public void Upcoming()
    {
        showRecent = true;
    }

}